{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ratanmoti-maintenance",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-07-18",
  "compatibility_flags": ["nodejs_compat"],

  // Workers Static Assets. One deploy serves both the API and the PWA,
  // so there is no Pages plus Worker split and one custom domain covers it.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "observability": {
    "enabled": true
  },

  // Sweeper for logs stuck in pending_transcription.
  // Cloudflare Queues needs a paid plan, so this is the retry mechanism.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ratanmoti-maintenance",
      "database_id": "d0a6a46f-fa92-4ccb-8947-b0861e4e1a88",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "ratanmoti-maintenance-audio"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "19cd8e4e70fb41068dc5929a4ce189e5"
    }
  ],

  "vars": {
    "STT_PROVIDER": "whisper",
    "STT_MODE": "hybrid",
    "AUDIO_RETENTION_DAYS": "730",
    "APP_TIMEZONE": "Asia/Kolkata"
  },

  // Secrets are NOT set here. Use `wrangler secret put`:
  //   JWT_SECRET
  //   WHISPER_URL     self hosted faster-whisper on KVM4, via the tunnel
  //   WHISPER_TOKEN   bearer token for that endpoint
  // There is no third party AI key, because there is no third party AI.

  "routes": [
    {
      "pattern": "maintenance.ratanmoti.in",
      "custom_domain": true
    }
  ]
}
