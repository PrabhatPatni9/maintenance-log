{
  "name": "ratanmoti-maintenance",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,green \"pnpm dev:web\" \"pnpm dev:worker\"",
    "dev:web": "vite",
    "dev:worker": "wrangler dev --local",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply ratanmoti-maintenance --local",
    "db:migrate:prod": "wrangler d1 migrations apply ratanmoti-maintenance --remote",
    "db:seed:local": "tsx scripts/seed.ts --local",
    "build": "tsc -p tsconfig.web.json --noEmit && vite build",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.121.0",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "hono": "^4.6.16",
    "jose": "^5.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@fontsource/anek-devanagari": "^5.1.1",
    "@fontsource/anek-latin": "^5.1.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
